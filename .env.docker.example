# Copy this file to .env.docker (same directory as docker-compose.yaml) and
# fill in the values, then run:
#   docker compose --env-file .env.docker up -d
#
# Deliberately NOT named .env — that name is docker compose's (and this repo's
# own settings/dev.py, via django-environ) implicit default, and it's also
# what the app's own .env.example (for local dev via `manage.py runserver`)
# gets copied to. Keeping this one as .env.docker means both can sit in the
# repo at once without one clobbering the other depending on what you're doing.

# ── Django ───────────────────────────────────────────────────────────────
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=seedview.example.com
CSRF_TRUSTED_ORIGINS=https://seedview.example.com

# ── Postgres ─────────────────────────────────────────────────────────────
POSTGRES_DB=seedview
POSTGRES_USER=seedview
POSTGRES_PASSWORD=change-me
# Host port the db container's 5432 is published on (rarely needs changing).
POSTGRES_PORT=5432

# ── Google OAuth 2.0 ─────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Application type: Web application
# Authorized redirect URIs: https://<your-domain>/accounts/google/login/callback/
GOOGLE_OAUTH2_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH2_CLIENT_SECRET=your-client-secret

# Google API Key (for Google Drive Picker)
# Create a Browser API key in Google Cloud Console
# Enable: Google Picker API, Google Drive API
GOOGLE_API_KEY=your-api-key

# ── RunPod Serverless endpoint (YOLO26 seed/pod detector) ─────────────────────────────────────────────────
RUNPOD_BASE_URL=https://api.runpod.ai/v2/39hov69mmwkuf9
RUNPOD_API_KEY=your-runpod-api-key
# Optional tuning (defaults shown):
# RUNPOD_INFERENCE_SIZE=512     # must match the handler's decode_img() expected size
# RUNPOD_MAX_CONCURRENCY=4      # images in flight at once
# RUNPOD_JOB_TIMEOUT=300        # seconds per image incl. queue + cold start
# RUNPOD_WARMUP_TIMEOUT=180     # seconds to wait for a worker on Configure

# ── Optional: auto-create a superuser on first boot ───────────────────────
# Only runs once — if this user already exists, the container start-up step
# is a no-op and won't touch its password. Leave all three unset to skip
# entirely (e.g. if you'd rather run `manage.py createsuperuser` by hand via
# `docker compose exec web`). Generate a password with: openssl rand -base64 24
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=you@example.com
# DJANGO_SUPERUSER_PASSWORD=change-me

# ── Image / container tuning (all optional — sensible defaults apply) ────
# Which image:tag docker-compose.yaml's web service runs. build_container.sh
# builds both IMAGE_NAME:IMAGE_TAG and IMAGE_NAME:latest — point this at
# whichever you want running.
# IMAGE_NAME=ghcr.io/oxbow-solutions/tli_plp_sainfoin_seed_app
# IMAGE_TAG=latest
# WEB_PORT=8000
# GUNICORN_WORKERS=3
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=120
